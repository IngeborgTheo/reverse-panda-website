# Never put RESEND_API_KEY or Firebase Admin / Functions secrets here.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
RECAPTCHA_ENTERPRISE_SITE_KEY=
